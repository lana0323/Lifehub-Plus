<?xml version='1.0' encoding='utf-8'?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:ns1="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" ns1:context="com.lifeHub.todo.ui.AddEditMemoActivity" android:background="@color/background">
  <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:elevation="0dp" android:background="@color/background">
