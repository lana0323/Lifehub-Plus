<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_eyebrow" android:textSize="11sp" android:letterSpacing="0.16" android:textColor="@color/brand_teal_dark" />
        <TextView android:id="@+id/tvUserName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/hello" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_subtitle" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardTodo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="5dp" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/brand_teal_light" app:strokeWidth="1dp" app:cardBackgroundColor="@color/card_background" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="152dp" android:padding="18dp" android:orientation="vertical">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_lh_memo" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/title_memorandum" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_memo_hint" android:textSize="12sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSchedule" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="5dp" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/brand_teal_light" app:strokeWidth="1dp" app:cardBackgroundColor="@color/card_background" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="152dp" android:padding="18dp" android:orientation="vertical">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_lh_calendar" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/title_schedule" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_schedule_hint" android:textSize="12sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardAccount" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="5dp" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/brand_teal_light" app:strokeWidth="1dp" app:cardBackgroundColor="@color/card_background" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="152dp" android:padding="18dp" android:orientation="vertical">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_lh_wallet" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/title_account" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_finance_hint" android:textSize="12sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardHealth" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_margin="5dp" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/brand_teal_light" app:strokeWidth="1dp" app:cardBackgroundColor="@color/card_background" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="152dp" android:padding="18dp" android:orientation="vertical">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_lh_health" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/title_health" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_health_hint" android:textSize="12sp" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:layout_marginTop="24dp" android:background="@drawable/bg_finance_hero">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_ai_title" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/white" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_ai_hint" android:textColor="@color/finance_mint" android:layout_marginTop="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAiChat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/btn_ai_chat" app:icon="@drawable/ic_lh_spark" app:backgroundTint="@color/finance_mint" android:textColor="@color/finance_ink" app:iconTint="@color/finance_ink" style="@style/Widget.LifeHub.Button" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>