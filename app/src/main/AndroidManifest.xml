<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.LifeHub">
        <service android:name="androidx.appcompat.app.AppLocalesMetadataHolderService" android:enabled="false" android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>
        <activity
            android:name=".main.ui.OpenPage"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".main.ui.MainPage"
            android:exported="false"
            android:label="@string/title_activity_main_page" />
        <activity
            android:name=".schedule.ui.AddEventActivity"
            android:exported="false"
            android:label="@string/title_add_event" />
        <activity
            android:name=".usage.HealthActivity"
            android:exported="false"
            android:label="@string/title_health" />
        <activity
            android:name=".finance.ui.AddExpenseActivity"
            android:theme="@style/Theme.LifeHub.Sheet"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"
            android:label="@string/add_memo" />
        <activity
            android:name=".todo.ui.MemorandumActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity
            android:name=".todo.ui.AddEditMemoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".todo.ui.MemorandumActivity" />

        <activity
            android:name=".login.LoginActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".login.RegisterActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />


    </application>

</manifest>