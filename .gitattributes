# Frozen evaluation hashes describe Windows working-tree bytes.
# Keep checkout line endings stable so the audit also works on Linux/macOS.
backend/evaluation/*.json text eol=crlf
backend/evaluation/mobile_holdout_v3.json text eol=crlf
backend/action_service.py text eol=crlf
backend/action_rules.py text eol=lf
backend/text_evidence.py text eol=lf
backend/task_service.py text eol=crlf
app/src/main/java/com/lifeHub/ai/ui/AiChatViewModel.kt text eol=crlf
app/src/main/java/com/lifeHub/ai/ui/AiChatFragment.kt text eol=crlf
backend/evaluate_holdout.py text eol=crlf
backend/evaluate_actions.py text eol=crlf
app/src/androidTest/java/com/lifeHub/ai/HoldoutWorkflowTest.kt text eol=crlf
app/src/main/python/*.py text eol=lf
app/src/main/java/com/lifeHub/ai/data/MobileAiApi.kt text eol=lf
app/src/main/java/com/lifeHub/ai/data/UnicodeSafeMessages.java text eol=lf
app/src/main/java/com/lifeHub/ai/data/MobileModelStore.kt text eol=lf
scripts/mobile-evaluation/*.py text eol=lf
scripts/mobile-evaluation/*.java text eol=lf
scripts/mobile-evaluation/*.ps1 text eol=lf
scripts/summarize-mobile-evaluation.py text eol=lf
# Preserve captured model whitespace and embedded newlines in CSV cells.
docs/evaluation-mobile-v4-regression/*.json text eol=crlf
docs/evaluation-mobile-v4-regression/*.csv -text -whitespace

# Preserve exact unseen first-pass evidence bytes.
backend/evaluation/mobile_unseen_v5.json -text whitespace=cr-at-eol
docs/evaluation-unseen-v5/*.json -text whitespace=cr-at-eol
docs/evaluation-unseen-v5/*.sha256 -text whitespace=cr-at-eol
docs/evaluation-unseen-v5/*.csv -text -whitespace
docs/evaluation-unseen-v5/frozen-snapshot.zip -text

# Historical report snapshot is retained byte-for-byte.
docs/evaluation-unseen-v5/provenance/v4-report-at-freeze.md -text whitespace=cr-at-eol
docs/evaluation-mobile-v4-regression/REPORT.md text eol=crlf
